# Copie para .env.local e preencha apenas o que for usar.
NEXT_PUBLIC_SITE_URL=https://nexgran.vercel.app
# Código fornecido pelo Google Search Console após adicionar/verificar a propriedade (opcional)
GOOGLE_SITE_VERIFICATION=
# Tracking (deixe vazio enquanto não houver contas)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Endpoint opcional para receber o formulário (backend/CRM). Vazio = fluxo 100% WhatsApp.
NEXT_PUBLIC_FORM_ENDPOINT=
